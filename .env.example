# Web app — copy to `.env` (gitignored) and adjust.

# Dev server port. Must match FRONTEND_URL in critpath-be/.env (CORS + sign-in).
PORT=5173

# Base URL of the CritPath API. In production set it to /api: the Worker (worker/index.ts) proxies
# /api (and /.well-known) to the Railway API, so the app and API share one origin.
VITE_API_BASE_URL=http://localhost:5000/api
