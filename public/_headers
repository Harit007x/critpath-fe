# Cloudflare static assets; what vercel.json's headers did.
# A demo deployment: kept out of search results.
/*
  X-Robots-Tag: noindex
  Strict-Transport-Security: max-age=63072000

# Polled by open tabs to notice a deploy (src/lib/version-watch.ts).
/version.json
  Cache-Control: no-store

# Vite hashes these file names, so a cached copy can never be stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
